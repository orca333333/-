<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Menus 3 (news) and the AI title summarizer need network access; menus 2/3/5 keep no other
         permission beyond what notification access / accessibility already grant via Settings. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Daily "채팅방/가계부 갱신 준비됨" reminder notifications (Android 13+ requires this at runtime too). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Apps this app must be able to see/launch (Android 11+ package visibility). -->
    <queries>
        <package android:name="com.kakao.talk" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.rainist.banksalad2" />
        <package android:name="com.twitter.android" />
        <package android:name="com.instagram.android" />
        <package android:name="com.zhiliaoapp.musically" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".ChatBridgeApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ChatBridge"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ChatBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads incoming KakaoTalk notifications. Enabled manually by the user under
             Settings > Notifications > Notification access (no official read API exists). -->
        <service
            android:name=".notification.KakaoNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Drives KakaoTalk (menu 1 replies), BankSalad (menu 5 ledger scrape) and X/Instagram/TikTok
             (menu 4 scrape) UIs, since none of them offer an API for this. Enabled manually by the
             user under Settings > Accessibility. -->
        <service
            android:name=".accessibility.BridgeAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
