<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- KakaoTalk must be visible to this app (Android 11+ package visibility) so it can be launched
         from the accessibility service when delivering a reply. -->
    <queries>
        <package android:name="com.kakao.talk" />
    </queries>

    <application
        android:name=".ChatBridgeApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ChatBridge"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ChatBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads incoming KakaoTalk notifications. Enabled manually by the user under
             Settings > Notifications > Notification access (no official read API exists). -->
        <service
            android:name=".notification.KakaoNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Drives the KakaoTalk UI to type and send a reply. Enabled manually by the user under
             Settings > Accessibility (no official send API exists). -->
        <service
            android:name=".accessibility.KakaoReplyAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
